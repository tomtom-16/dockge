# syntax=docker/dockerfile:1
# Build assets natively on the Mac's Linux builder; only runtime deps use emulation.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS frontend
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run lint && npm run check-ts && npm run test:maintenance && npm run build:frontend

FROM --platform=$BUILDPLATFORM golang:1.24-bookworm AS healthcheck
WORKDIR /app
ARG TARGETARCH
ARG TARGETOS
COPY extra/healthcheck.go ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /healthcheck healthcheck.go

FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim AS release
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg dumb-init \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends docker-ce-cli docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=frontend /app/frontend-dist ./frontend-dist
COPY --from=healthcheck /healthcheck ./extra/healthcheck
COPY backend ./backend
COPY common ./common
COPY extra ./extra
COPY package*.json tsconfig.json ./
RUN mkdir -p /app/data
ENV NODE_ENV=production UV_USE_IO_URING=0
LABEL org.opencontainers.image.title="Dockge mobile" \
    org.opencontainers.image.description="Dockge with mobile layout fixes and Docker image cleanup"
VOLUME /app/data
EXPOSE 5001
HEALTHCHECK --interval=60s --timeout=30s --start-period=60s --retries=5 CMD extra/healthcheck
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["./node_modules/.bin/tsx", "./backend/index.ts"]
