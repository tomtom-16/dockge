{
    "name": "dockge",
    "version": "1.5.0",
    "type": "module",
    "engines": {
        "node": ">= 26.0.0"
    },
    "scripts": {
        "fmt": "eslint \"**/*.{ts,vue}\" --fix",
        "lint": "eslint \"**/*.{ts,vue}\" --max-warnings=0",
        "check-ts": "tsc --noEmit",
        "start": "tsx ./backend/index.ts",
        "dev": "concurrently -k -r \"wait-on tcp:5000 && npm run dev:backend \" \"npm run dev:frontend\"",
        "dev:backend": "cross-env NODE_ENV=development tsx watch --inspect ./backend/index.ts",
        "dev:frontend": "cross-env NODE_ENV=development vite --host --config ./frontend/vite.config.ts",
        "release-final": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker",
        "release-beta": "tsx ./extra/test-docker.ts && tsx extra/update-version.ts && npm run build:frontend && npm run build:docker-beta",
        "build:frontend": "vite build --config ./frontend/vite.config.ts",
        "build:docker-base": "docker buildx build --platform linux/amd64,linux/arm64 -t louislam/dockge:base -f ./docker/Base.Dockerfile . --push",
        "build:docker": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64 -t louislam/dockge:latest -t louislam/dockge:1 -t louislam/dockge:$VERSION -t louislam/dockge:beta -t louislam/dockge:nightly --target release -f ./docker/Dockerfile . --push",
        "build:docker-beta": "node ./extra/env2arg.js docker buildx build --platform linux/amd64,linux/arm64 -t louislam/dockge:beta -t louislam/dockge:$VERSION --target release -f ./docker/Dockerfile . --push",
        "build:healthcheck": "docker buildx build -f docker/BuildHealthCheck.Dockerfile --platform linux/amd64,linux/arm64 -t louislam/dockge:build-healthcheck . --push",
        "release-nightly": "npm run build:frontend && docker buildx build --platform linux/amd64,linux/arm64 -t louislam/dockge:nightly -t ghcr.io/louislam/dockge:nightly --target nightly -f ./docker/Dockerfile . --push",
        "start-docker": "docker run --rm -p 5001:5001 --name dockge louislam/dockge:latest",
        "mark-as-nightly": "tsx ./extra/mark-as-nightly.ts",
        "reformat-changelog": "tsx ./extra/reformat-changelog.ts",
        "reset-password": "tsx ./extra/reset-password.ts",
        "test:maintenance": "tsx --test tests/docker-maintenance.test.ts",
        "build:local": "docker buildx build --platform linux/amd64 -f docker/Dockerfile.local -t ghcr.io/tomtom-16/dockge:mobile-v1 --load .",
        "publish:local": "docker push --platform linux/amd64 ghcr.io/tomtom-16/dockge:mobile-v1",
        "test:native": "node --import tsx --test tests/native-modules.test.ts",
        "test:compat": "node --import tsx --test tests/dependency-compatibility.test.ts"
    },
    "dependencies": {
        "@homebridge/node-pty-prebuilt-multiarch": "0.15.0",
        "@inventage/envsubst": "^0.16.0",
        "bcryptjs": "^3.0.3",
        "check-password-strength": "~2.0.10",
        "command-exists": "~1.2.9",
        "compare-versions": "~6.1.1",
        "composerize": "~1.7.6",
        "croner": "~8.1.2",
        "dayjs": "~1.11.23",
        "dotenv": "^16.6.1",
        "express": "^4.22.3",
        "express-static-gzip": "~2.1.8",
        "http-graceful-shutdown": "^3.1.16",
        "jsonwebtoken": "^9.0.3",
        "jwt-decode": "^4.0.0",
        "knex": "~3.3.0",
        "limiter-es6-compat": "~2.1.2",
        "mysql2": "^3.24.6",
        "promisify-child-process": "~4.1.2",
        "redbean-node": "~0.4.0",
        "semver": "^7.8.6",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "sqlite3": "^6.0.1",
        "timezones-list": "^3.1.0",
        "ts-command-line-args": "~2.5.1",
        "tsx": "^4.23.15",
        "type-fest": "~4.3.3",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@actions/github": "^9.1.1",
        "@codemirror/lang-python": "^6.1.7",
        "@codemirror/lang-yaml": "^6.1.3",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fortawesome/fontawesome-svg-core": "^6.7.2",
        "@fortawesome/free-regular-svg-icons": "^6.7.2",
        "@fortawesome/free-solid-svg-icons": "^6.7.2",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@types/bootstrap": "~5.2.11",
        "@types/command-exists": "~1.2.3",
        "@types/express": "^4.17.25",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/semver": "^7.8.0",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "bootstrap": "^5.3.8",
        "bootstrap-vue-next": "~0.14.10",
        "codemirror": "^6.0.1",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "eslint": "~8.57.1",
        "eslint-plugin-jsdoc": "~46.8.2",
        "eslint-plugin-vue": "~9.32.0",
        "sass": "^1.107.1",
        "thememirror": "^2.0.1",
        "typescript": "~5.9.3",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "vite-plugin-compression": "~0.5.1",
        "vue": "^3.5.44",
        "vue-codemirror6": "^1.7.0",
        "vue-eslint-parser": "~9.3.2",
        "vue-i18n": "^11.4.18",
        "vue-qrcode": "~2.2.2",
        "vue-router": "^4.6.4",
        "vue-toastification": "2.0.0-rc.5",
        "wait-on": "^9.5.1"
    },
    "allowScripts": {
        "@homebridge/node-pty-prebuilt-multiarch@0.15.0": true,
        "vue-demi@0.14.10": true,
        "fsevents@2.3.3": true,
        "sqlite3@6.0.1": true,
        "esbuild@0.28.2": true,
        "@parcel/watcher@2.6.0": true
    },
    "overrides": {
        "redbean-node": {
            "glob": "^14.0.3"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.4"
        }
    }
}
